    {
      "parameters": {
        "jsCode": "// DETERMINE NEW OR OLD\n// Compare the last 10 digits of the phone so 0801..., +234801... and 801... all match.\nconst lead = $('Process Current Input').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r['Lead ID']);\n\nconst last10 = p => String(p || '').replace(/\\D/g, '').slice(-10);\nconst target = last10(lead.phone);\nconst isOld = rows.some(r => last10(r['Phone']) === target);\n\n// Highest existing Lead ID number (used by the next node to build LD-00X)\nlet maxNum = 0;\nfor (const r of rows) {\n  const n = parseInt(String(r['Lead ID']).replace(/\\D/g, ''), 10);\n  if (!isNaN(n) && n > maxNum) maxNum = n;\n}\n\nreturn [{ json: { ...lead, leadStatus: isOld ? 'OLD' : 'NEW', maxNum } }];"
      },
