    {
      "parameters": {
        "jsCode": "// PROCESS CURRENT INPUT - the state machine.\n// Reads the saved session + the new message, decides the next state and the reply.\nconst msg = $('Get Message Data').first().json;\nconst allRows = $input.all().map(i => i.json).filter(r => r && r['Telegram User ID']);\nallRows.sort((a, b) => String(b['Updated At'] || '').localeCompare(String(a['Updated At'] || '')));\nconst row = allRows[0] || {};\n\n// Telegram sometimes re-delivers updates, and duplicates can slip in.\n// If this update_id was already handled for this user, do nothing.\nconst lastId = Number(row['Last Update ID'] || 0);\nif (msg.updateId && lastId && msg.updateId <= lastId) {\n  return [{ json: { action: 'ignore' } }];\n}\n\nconst SERVICES = [\n  { label: '🌐 Web Design', value: 'Web Design' },\n  { label: '🤖 AI Automation', value: 'AI Automation' },\n  { label: '📊 Data Analysis', value: 'Data Analysis' },\n  { label: '🔐 Cybersecurity', value: 'Cybersecurity' },\n  { label: '🎨 Digital Design', value: 'Digital Design' },\n  { label: '📣 Digital Marketing', value: 'Digital Marketing' },\n  { label: '💻 Web Development', value: 'Web Development' }\n];\n\nconst text = (msg.text || '').trim();\nconst lower = text.toLowerCase();\nconst now = $now.setZone('Africa/Lagos').toFormat('yyyy-MM-dd HH:mm:ss');\n\n// Telegram reads _ * ` [ ] as formatting marks and rejects the message if they are unpaired.\n// Remove them from anything a customer types.\nconst clean = s => String(s).replace(/[_*`\\[\\]]/g, '').trim();\n\nconst state = String(row['State'] || 'START').trim() || 'START';\nconst data = {\n  name: String(row['Name'] || ''),\n  phone: String(row['Phone'] || ''),\n  service: String(row['Service'] || ''),\n  date: String(row['Preferred Date'] || ''),\n  time: String(row['Preferred Time'] || '')\n};\nconst cleared = { name: '', phone: '', service: '', date: '', time: '' };\n\nlet newState = state;\nlet reply = '';\nlet replyType = 'text';   // text | services | confirm\nlet action = 'reply';     // reply | submit\n\nconst GREETINGS = ['hi', 'hello', 'hey', 'start', '/start', 'restart', '/restart'];\nconst WELCOME = \"👋 Hello! Welcome to our business.\\n\\nWe provide professional digital and technology services.\\nI'd like to get a few details from you so we can understand how we can help.\\n\\nWhat is your name?\";\nconst RESTART = \"👋 Welcome!\\nLet's get your consultation request started.\\n\\nWhat is your name?\";\n\nfunction summary(d) {\n  return 'Before we submit your request, here is the information you provided:\\n\\n' +\n    'Name: ' + d.name + '\\nPhone: ' + d.phone + '\\nService: ' + d.service +\n    '\\nPreferred Date: ' + d.date + '\\nPreferred Time: ' + d.time +\n    '\\n\\nIs this information correct?';\n}\n\nfunction cleanPhone(raw) {\n  let p = String(raw).replace(/[\\s\\-().]/g, '');\n  if (!/^\\+?\\d{10,15}$/.test(p)) return null;\n  if (/^\\+?234\\d{10}$/.test(p)) return '0' + p.slice(-10);   // +234801... -> 0801...\n  return p;\n}\n\nif (lower === '/cancel' || lower === 'cancel') {\n  Object.assign(data, cleared);\n  newState = 'START';\n  reply = \"❌ Your current request has been cancelled.\\nWhenever you're ready, send /start to begin again.\";\n} else if (GREETINGS.includes(lower)) {\n  const fresh = state === 'START' || state === 'COMPLETE';\n  Object.assign(data, cleared);\n  newState = 'WAITING_NAME';\n  reply = fresh ? WELCOME : RESTART;\n} else if (msg.isButton && !['WAITING_SERVICE', 'CONFIRMING'].includes(state)) {\n  reply = 'That button is no longer active. Please answer the current question, or send /cancel to stop.';\n} else {\n  switch (state) {\n    case 'WAITING_NAME': {\n      const name = clean(text);\n      if (name.length < 2 || name.length > 60 || text.startsWith('/')) {\n        reply = 'Please enter your name (at least 2 characters).';\n      } else {\n        data.name = name;\n        newState = 'WAITING_PHONE';\n        reply = 'Nice to meet you, ' + name + '!\\nPlease enter your phone number.';\n      }\n      break;\n    }\n\n    case 'WAITING_PHONE': {\n      const phone = cleanPhone(text);\n      if (!phone) {\n        reply = \"That doesn't look like a valid phone number.\\nPlease enter it like 08012345678 or +2348012345678.\";\n      } else {\n        data.phone = phone;\n        newState = 'WAITING_SERVICE';\n        replyType = 'services';\n        reply = 'Thanks!\\nWhich service are you interested in?\\nPlease tap one of the buttons below.';\n      }\n      break;\n    }\n\n    case 'WAITING_SERVICE': {\n      const svc = SERVICES.find(s => lower === s.label.toLowerCase() || lower === s.value.toLowerCase());\n      if (!svc) {\n        replyType = 'services';\n        reply = 'Please choose one of the services using the buttons below.';\n      } else {\n        data.service = svc.value;\n        newState = 'WAITING_DATE';\n        reply = 'Great choice! You selected ' + svc.value + '.\\nWhat date would you prefer for your booking?\\n(For example: October 10)';\n      }\n      break;\n    }\n\n    case 'WAITING_DATE': {\n      const d = clean(text);\n      if (!d || d.length > 50 || text.startsWith('/')) {\n        reply = 'Please enter your preferred date (for example: October 10).';\n      } else {\n        data.date = d;\n        newState = 'WAITING_TIME';\n        reply = 'What time would you prefer?\\n(For example: 2:00 PM)';\n      }\n      break;\n    }\n\n    case 'WAITING_TIME': {\n      const t = clean(text);\n      if (!t || t.length > 50 || text.startsWith('/')) {\n        reply = 'Please enter your preferred time (for example: 2:00 PM).';\n      } else {\n        data.time = t;\n        newState = 'CONFIRMING';\n        replyType = 'confirm';\n        reply = summary(data);\n      }\n      break;\n    }\n\n    case 'CONFIRMING':\n      if (lower.includes('confirm')) {\n        action = 'submit';\n      } else if (lower.includes('edit')) {\n        Object.assign(data, cleared);\n        newState = 'WAITING_NAME';\n        reply = \"No problem, let's start again.\\nWhat is your name?\";\n      } else {\n        replyType = 'confirm';\n        reply = 'Please tap ✅ Confirm or ✏️ Edit.\\n\\n' + summary(data);\n      }\n      break;\n\n    default:   // START, COMPLETE, or anything unknown\n      reply = '👋 Hi! Send /start to begin a consultation request.';\n      break;\n  }\n}\n\nreturn [{\n  json: {\n    action,\n    userId: msg.userId,\n    chatId: msg.chatId,\n    username: msg.username,\n    newState,\n    name: data.name,\n    phone: data.phone,\n    service: data.service,\n    date: data.date,\n    time: data.time,\n    reply,\n    replyType,\n    updatedAt: now,\n    updateId: msg.updateId\n  }\n}];"
      },
