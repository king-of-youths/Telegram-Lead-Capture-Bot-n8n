      "parameters": {
        "jsCode": "// Pull the useful fields out of the raw Telegram update.\n// Works for normal text messages AND for taps on inline buttons (callback_query).\nconst u = $input.first().json;\nconst cb = u.callback_query;\nconst m = cb ? (cb.message || {}) : (u.message || {});\nconst from = cb ? (cb.from || {}) : (m.from || {});\nreturn [{\n  json: {\n    userId: String(from.id || ''),\n    chatId: String((m.chat && m.chat.id) || from.id || ''),\n    username: from.username ? '@' + from.username : '',\n    firstName: from.first_name || '',\n    text: cb ? String(cb.data || '').trim() : (m.text || '').trim(),\n    isButton: !!cb,\n    callbackId: cb ? String(cb.id) : '',\n    updateId: Number(u.update_id || 0)\n  }\n}];"
      },
      "id": "f1415d8e-d039-48c4-932d-67f2054fec6d",
      "name": "Get Message Data",
      "type": "n8n-nodes-base.code",
